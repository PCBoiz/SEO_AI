      },
      "mapper": {
        "model": "deepseek-v4-flash",
        "thinking": false,
        "top_p": "1",
        "messages": [
          {
            "role": "system",
            "content": "Bạn là chuyên gia SEO. Chỉ trả về các nhãn sitemap đã chọn, không giải thích và không đánh số."
          },
          {
            "role": "user",
            "content": "Từ sitemap dưới đây, hãy chọn tối đa 30 nhãn quan trọng và phổ biến nhất, đồng thời giữ các nhãn cần thiết để website có cấu trúc đầy đủ và hữu ích. Chỉ trả về danh sách nhãn sitemap, mỗi nhãn một dòng.\n\n{{3.choices[].message.content}}"
          }
        ],
        "max_tokens": "2048",
        "temperature": "0.3",
