      "metadata": {
        "designer": {
          "x": 900,
          "y": 0,
          "name": "DeepSeek — chọn tối đa 30 nhãn"
        },
        "restore": {
          "parameters": {
            "__IMTCONN__": {
              "data": {
                "scoped": "true",
                "connection": "deepseek-ai"
              },
              "label": "Chọn connection DeepSeek của bạn"
            }
          },
          "expect": {
            "model": {
              "mode": "chose",
