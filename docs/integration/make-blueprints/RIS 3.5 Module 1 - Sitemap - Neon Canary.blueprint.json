        },
        "parameters": [
          {
            "name": "__IMTCONN__",
            "type": "account:deepseek-ai",
            "label": "Connection",
            "required": true
          }
        ]
      }
    },
    {
      "id": 5,
      "module": "postgres:StoredProcedure",
      "version": 2,
      "parameters": {
        "account": 14453762,
        "spname": "\"antigravity_bridge\".\"complete_sitemap_job\"",
        "ignore": false,
