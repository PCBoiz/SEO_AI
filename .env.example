# App Base Configuration
NODE_ENV=development
APP_RUNTIME=local
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth redirect URIs must exactly match:
# http://localhost:3000/api/v1/oauth/google/callback
# http://localhost:3000/api/v1/oauth/make/callback
GOOGLE_OAUTH_CLIENT_ID=<GOOGLE_WEB_CLIENT_ID>
GOOGLE_OAUTH_CLIENT_SECRET=<GOOGLE_WEB_CLIENT_SECRET>
MAKE_OAUTH_CLIENT_ID=<MAKE_OAUTH_CLIENT_ID>
MAKE_OAUTH_CLIENT_SECRET=<MAKE_OAUTH_CLIENT_SECRET>
# Do not guess these values. Copy the exact scopes approved for your Make OAuth client.
MAKE_OAUTH_SCOPES=<MAKE_APPROVED_SCOPES_SPACE_SEPARATED>
# One-time, exact verified Google email allowed to claim the seeded owner account.
OAUTH_BOOTSTRAP_EMAIL=<NEW_GOOGLE_EMAIL>

# WordPress.com OAuth2 — cho nút "Kết nối WordPress.com" ở trang Dự án (Module 12
# đăng bài lên site *.wordpress.com gói Free/Cá nhân/Cao cấp, vốn không có
# Application Password). Tạo ứng dụng tại https://developer.wordpress.com/apps/
# và đặt Redirect URL khớp TUYỆT ĐỐI với:
#   http://localhost:3000/api/v1/integrations/wordpress-com/callback   (local)
#   https://<domain-that-app>/api/v1/integrations/wordpress-com/callback (production)
# Bỏ trống thì nút kết nối tự ẩn; người dùng vẫn dán token thủ công được.
WORDPRESS_COM_CLIENT_ID=<WORDPRESS_COM_CLIENT_ID>
WORDPRESS_COM_CLIENT_SECRET=<WORDPRESS_COM_CLIENT_SECRET>

# SQLite local database. On Vercel, set this to the Neon pooled PostgreSQL URL.
DATABASE_URL=local.db
# Local-only migration URL with schema-owner privileges; do not upload to Vercel.
MIGRATOR_DATABASE_URL=<NEON_OWNER_OR_MIGRATOR_CONNECTION_STRING>
STAGING_OWNER_EMAIL=<NEW_GOOGLE_EMAIL>
STAGING_OWNER_DISPLAY_NAME=Chủ sở hữu Staging

# Vault encryption key: exactly 32 bytes (64 hex characters or base64).
VAULT_ENCRYPTION_KEY=<GENERATE_32_BYTE_KEY>

# Independent session signing secret (at least 32 bytes; mandatory in production)
AUTH_SESSION_SECRET=<GENERATE_RANDOM_SESSION_SECRET>

# Durable storage. Vercel staging uses vercel_blob/private.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=.data/storage
VERCEL_BLOB_ACCESS=private
# Vercel Blob can use project OIDC + BLOB_STORE_ID. If the project integration
# supplies a token instead, keep it server-only and never prefix it NEXT_PUBLIC_.
BLOB_READ_WRITE_TOKEN=<VERCEL_BLOB_SERVER_TOKEN>
BLOB_STORE_ID=<VERCEL_BLOB_STORE_ID>

# Structured logging
LOG_LEVEL=info

# Optional Sentry bootstrap. Leave blank for local development.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# AI model registry. Keep mock until the owner confirms a paid live test.
AI_EXECUTION_MODE=mock
# Required when AI_EXECUTION_MODE=live. Enable one reviewed provider at a time.
AI_LIVE_PROVIDERS=
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1024
OPENAI_API_KEY=<OPENAI_SERVER_API_KEY>
OPENAI_MODEL=gpt-5.6-terra
DEEPSEEK_API_KEY=<DEEPSEEK_SERVER_API_KEY>
DEEPSEEK_MODEL=deepseek-v4-flash
GEMINI_API_KEY=<GEMINI_SERVER_API_KEY>
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=<ANTHROPIC_SERVER_API_KEY>
ANTHROPIC_MODEL=claude-sonnet-5

# HMAC Signing Webhook Shared Secret
MAKE_CALLBACK_SECRET=<GENERATE_RANDOM_SECRET>

# Module 1 Sitemap pilot. Keep `mock` until both Neon and Make are configured.
SITEMAP_PILOT_MODE=mock
SITEMAP_PILOT_POLL_INTERVAL_MS=2000
MAKE_DISPATCH_TIMEOUT_MS=10000
# Kill switch and allowlist are mandatory in neon_make mode.
SITEMAP_LIVE_CANARY_ENABLED=false
SITEMAP_LIVE_ALLOWED_AI_PROVIDERS=
# Sheets are never an automatic fallback. manual_mirror additionally requires
# SITEMAP_SHEET_MAPPING_VERIFIED=true after reconciliation against the live Sheet.
SITEMAP_GOOGLE_SHEETS_FALLBACK_MODE=disabled
SITEMAP_SHEET_MAPPING_VERIFIED=false

# Server-only Neon pooled connection string. Never expose this as NEXT_PUBLIC_*.
# Use a dedicated least-privileged bridge role rather than the database owner.
BRIDGE_DATABASE_URL=<NEON_POOLED_POSTGRESQL_CONNECTION_STRING>
BRIDGE_MIGRATOR_DATABASE_URL=<NEON_BRIDGE_MIGRATOR_CONNECTION_STRING>

# Webhooks Endpoints for Make.com Blueprints (resolved by WebhookResolver)
MAKE_WEBHOOK_RIS_SITEMAP=<MAKE_WEBHOOK_SITEMAP_URL>
MAKE_WEBHOOK_SITEMAP_KEYWORDS=<MAKE_WEBHOOK_KEYWORDS_URL>
MAKE_WEBHOOK_ICN_KEYWORDS=<MAKE_WEBHOOK_ICN_KEYWORDS_URL>
MAKE_WEBHOOK_IMPORTED_KEYWORDS=<MAKE_WEBHOOK_IMPORTED_KEYWORDS_URL>
MAKE_WEBHOOK_ONPAGE_SEO=<MAKE_WEBHOOK_ONPAGE_SEO_URL>
MAKE_WEBHOOK_HOMEPAGE_CONTENT=<MAKE_WEBHOOK_HOMEPAGE_CONTENT_URL>
MAKE_WEBHOOK_CONTENT_HEADLINE=<MAKE_WEBHOOK_CONTENT_HEADLINE_URL>
MAKE_WEBHOOK_CONTENT_INTRO=<MAKE_WEBHOOK_CONTENT_INTRO_URL>
MAKE_WEBHOOK_CONTENT_SECTIONS=<MAKE_WEBHOOK_CONTENT_SECTIONS_URL>
MAKE_WEBHOOK_UPLOAD_WORDPRESS=<MAKE_WEBHOOK_UPLOAD_WORDPRESS_URL>
